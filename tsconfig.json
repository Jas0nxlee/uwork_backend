{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "outDir": "dist", "rootDir": "src", "esModuleInterop": true,
    "skipLibCheck": true, "noUncheckedIndexedAccess": true, "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"]
}
