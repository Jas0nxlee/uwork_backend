{
  "name": "uwork-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.13.0 <25" },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build --config admin/vite.config.ts",
    "build:server": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.verify.json && tsc -p admin/tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "admin:dev": "vite --config admin/vite.config.ts",
    "init": "node --env-file-if-exists=.env --import tsx src/cli.ts init",
    "backup": "node --env-file-if-exists=.env --import tsx scripts/backup.ts",
    "lint": "eslint src tests admin/src scripts --ext .ts,.tsx",
    "format": "prettier --write src tests admin tasks 'docs/*.md' SPEC-*.md 'scripts/**/*.ts' 'scripts/fixtures/*.mjs'",
    "format:check": "prettier --check src tests admin tasks 'docs/*.md' SPEC-*.md 'scripts/**/*.ts' 'scripts/fixtures/*.mjs'"
  },
  "dependencies": {
    "@openai/agents-core": "0.20.0",
    "dockerode": "5.0.1",
    "fastify": "5.12.7",
    "zod": "4.6.7",
    "cron-parser": "5.10.2",
    "ipaddr.js": "2.2.0",
    "undici": "7.30.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "lucide-react": "0.468.0"
  },
  "devDependencies": {
    "@types/dockerode": "4.0.2",
    "typescript": "5.9.3",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tsx": "4.20.6",
    "vite": "7.3.7",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.39.1",
    "typescript-eslint": "8.71.2",
    "prettier": "3.6.2"
  }
}
