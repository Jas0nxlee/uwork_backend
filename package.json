{
  "name": "uwork-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.13.0 <25" },
  "packageManager": "npm@11.11.1",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build --config admin/vite.config.ts",
    "build:server": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit && tsc -p admin/tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "admin:dev": "vite --config admin/vite.config.ts",
    "init": "node --env-file-if-exists=.env --import tsx src/cli.ts init",
    "lint": "eslint src tests admin/src",
    "format": "prettier --write src tests admin tasks SPEC-*.md",
    "format:check": "prettier --check src tests admin tasks SPEC-*.md"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "zod": "4.6.7",
    "cron-parser": "5.10.2",
    "ipaddr.js": "2.2.0",
    "undici": "7.16.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "lucide-react": "0.468.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tsx": "4.20.6",
    "vite": "7.1.12",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.39.1",
    "typescript-eslint": "8.46.3",
    "prettier": "3.6.2"
  }
}
