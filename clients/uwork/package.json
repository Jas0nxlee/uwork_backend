{
  "name": "zcode",
  "version": "3.16.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev:web": "concurrently -k -n server,web -c blue,green \"pnpm --filter @zcode/server dev\" \"pnpm --filter @zcode/web dev\"",
    "dev:desktop": "pnpm run dev:desktop:prod",
    "dev:desktop:test": "node scripts/dev-desktop-env.mjs test",
    "dev:desktop:prod": "node scripts/dev-desktop-env.mjs production",
    "dev:desktop:bytecode": "node scripts/dev-desktop-env.mjs production --agent-bytecode",
    "dev:desktop:remote-prod": "node scripts/dev-desktop-remote-prod.mjs",
    "dev:server": "pnpm --filter @zcode/server dev",
    "prepare": "husky",
    "prepare:desktop-runtime": "pnpm --filter @zcode/desktop prepare:runtime-assets",
    "dep:graph": "node scripts/dependency-graph.mjs",
    "dep:refs": "node scripts/dep-refs.mjs",
    "verify:pre-push": "pnpm run lint && pnpm run architecture:check -- --changed",
    "build": "pnpm -r build",
    "build:desktop-agent:bytecode": "node scripts/build-desktop-agent-bytecode.mjs",
    "build:zcode": "node scripts/build-zcode.mjs",
    "build:bootstrap": "pnpm -r --filter \"./packages/*\" --filter \"!@zcode/desktop\" build && pnpm --filter @zcode/desktop build:no-runtime-assets",
    "build:sea": "pnpm --dir apps/zcode-cli build:sea",
    "build:sea:all": "pnpm install && pnpm --dir apps/zcode-cli build:sea",
    "build:native-search": "node scripts/build-native-search-tools.mjs",
    "pack:native-search": "node scripts/package-native-search-tools.mjs",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -b packages/rpc packages/provider packages/provider-node packages/shared packages/services packages/client packages/server packages/zcode-server-cli packages/ui packages/web packages/desktop/tsconfig.host.json",
    "test:enterprise-policy": "tsc -p apps/zcode-cli/tsconfig.test.json && tsx --tsconfig apps/zcode-cli/tsconfig.test.json --test apps/zcode-cli/packages/core/test/*.test.ts && tsx --test packages/services/test/enterprise*.test.ts packages/services/test/uworkBackendSession.test.ts packages/services/test/uworkIdentityIssuer.test.ts packages/services/test/ucasGateway*.test.ts packages/services/test/uworkToolAuthorization.test.ts",
    "test:enterprise-workflow": "tsc -p apps/zcode-cli/tsconfig.workflow-tests.json && tsx --tsconfig apps/zcode-cli/tsconfig.workflow-tests.json --test apps/zcode-cli/packages/core/test/enterprise-workflow-execution.test.ts apps/zcode-cli/packages/bootstrap/test/enterprise-workflow-*.test.ts apps/zcode-cli/packages/dynamic-workflow-runtime/test/enterprise-workflow-harness.test.ts",
    "test:enterprise-provider-settings": "tsc -b packages/shared packages/rpc packages/provider packages/provider-node && tsc -p packages/services/tsconfig.enterprise-provider-settings-test.json && tsx --test packages/services/test/uworkProviderSettingsPolicy.test.ts",
    "test:enterprise-sharing": "tsc -b packages/shared packages/rpc && tsc -p packages/services/tsconfig.enterprise-sharing-test.json && tsc -p packages/ui/tsconfig.enterprise-sharing-test.json && tsx --test packages/services/test/uworkConversationSharing.test.ts packages/services/test/uworkManagedConversationSharing.test.ts packages/services/test/uworkShareManagedAdmission.test.ts packages/services/test/uworkShareRequestBounds.test.ts packages/services/test/uworkShareLocalFiles.test.ts && tsx --tsconfig packages/ui/tsconfig.enterprise-sharing-test.json --test packages/ui/test/conversationShareAccess.test.ts packages/ui/test/conversationSharePermission.test.tsx",
    "test:enterprise-console": "tsc -b packages/shared packages/rpc && tsc -p packages/services/tsconfig.enterprise-console-test.json && tsx --test packages/services/test/enterpriseConsole.test.ts packages/services/test/enterpriseClientPresentation.test.ts packages/ui/test/enterpriseMenuNavigation.test.ts",
    "test:enterprise-assets": "tsc -b packages/shared packages/rpc && tsc -p packages/services/tsconfig.enterprise-assets-test.json && tsx --test packages/services/test/enterpriseAssetStore.test.ts packages/services/test/enterpriseAssetSelection.test.ts packages/services/test/enterpriseAssetsHost.test.ts packages/services/test/enterpriseAssetsBridge.test.ts packages/services/test/enterpriseExpertAssets.test.ts packages/services/test/enterpriseConnectorAssets.test.ts",
    "bundle:desktop": "pnpm --filter @zcode/desktop run bundle --",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "knip": "knip",
    "count-lines": "bash scripts/count-lines.sh",
    "prepare:remote-assets": "pnpm --filter @zcode/desktop prepare:remote-assets",
    "doctor:macos-release": "bash scripts/doctor-macos-release-app.sh",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-suggestions",
    "bootstrap": "node scripts/bootstrap.mjs",
    "bootstrap:with-remote": "node scripts/bootstrap.mjs --with-remote",
    "release": "release-it",
    "release:cli": "pnpm --dir apps/zcode-cli run release",
    "release:cli:dry": "pnpm --dir apps/zcode-cli run release:dry",
    "architecture:check": "node scripts/architecture/architecture-check.mjs check",
    "architecture:report": "node scripts/architecture/architecture-check.mjs report",
    "architecture:baseline:update": "node scripts/architecture/architecture-check.mjs baseline:update",
    "architecture:context": "node scripts/architecture/architecture-check.mjs context"
  },
  "dependencies": {
    "border-beam": "^1.0.1",
    "d3-path": "^3.1.0",
    "tailwind-scrollbar-hide": "^4.0.0"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^10.0.6",
    "@tanstack/react-virtual": "^3.13.23",
    "@types/node": "^25.5.0",
    "concurrently": "^9.1.2",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "conventional-changelog-writer": "^8.4.0",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "istanbul-lib-instrument": "6.0.3",
    "knip": "^6.0.6",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.57.0",
    "postject": "1.0.0-alpha.6",
    "release-it": "^19.2.4",
    "ts-morph": "^28.0.0",
    "tsx": "^4.19.4",
    "turbo": "^2.4.0",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "@tanstack/react-virtual": "^3.13.23"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.2"
}
