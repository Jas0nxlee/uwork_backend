# 主密钥：64 位十六进制（32 字节），生成示例 `openssl rand -hex 32`。
# 不要使用占位值或开发实例的密钥；丢失后 vault、任务和缓存密文无法恢复。
MASTER_KEY=replace_with_64_hex_characters
DATABASE_PATH=data/uwork.sqlite
# 生产必须是浏览器实际访问的 HTTPS origin；仅 localhost/127.0.0.1/[::1] 允许 http。
PUBLIC_URL=http://localhost:3000
HOST=127.0.0.1
PORT=3000
# 生产上游默认只允许公网 HTTPS；受控内部模型才在下面列出精确 HTTPS origin。
ALLOW_PRIVATE_UPSTREAMS=false
PRIVATE_MODEL_ORIGINS=

# 仅 `npm run init` 读取，均可选且不必预填；init 不打印秘密，也不重置已初始化数据库。
# BOOTSTRAP_EMAIL=admin@example.com
# BOOTSTRAP_PASSWORD=
# BOOTSTRAP_ORGANIZATION=UWork 本地企业

# 隔离代码执行：必须指向专用 Docker engine 的 Unix socket，不能复用承载其他业务的 engine。
# SANDBOX_DOCKER_SOCKET=/run/uwork-sandbox/docker.sock
SANDBOX_IMAGE=uwork-sandbox:local

# 以下两项只由 compose.sandbox.yaml 读取，应用本身不解析；两项都是必填，
# 缺失时 Compose 直接拒绝。不要把 socket 权限改成 world-writable。
# SANDBOX_HOST_SOCKET=/run/uwork-sandbox/docker.sock
# SANDBOX_SOCKET_GID=1000
